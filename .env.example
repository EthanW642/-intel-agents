# Copy this file to .env and fill in your key. Only Stage 4 (deep analysis)
# calls the Anthropic API; triage (Stage 2b) and prediction resolution
# (Stage 2c) run locally via Ollama and need no key.
ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP delivery (spec section 6). GMAIL_ADDRESS both sends and
# receives (self-send). GMAIL_APP_PASSWORD is the 16-character App
# Password from Google Account -> Security -> 2-Step Verification -> App
# Passwords (2-Step Verification must already be enabled) — NOT your
# regular Google account password. If these are unset, the pipeline still
# runs and writes the local .md briefing; it just skips the email step and
# logs why.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Oil price snapshot (pipeline/oil_prices.py, added 2026-07-31) — feeds
# Stage 4's "Economics & markets" analytical lens real WTI/Brent spot
# prices instead of relying on narrative claims from articles. Free,
# official EIA (U.S. Energy Information Administration) API — register at
# https://www.eia.gov/opendata/register.php, no credit card required. If
# unset, the pipeline still runs normally; it just omits the oil snapshot
# section from the analysis prompt.
EIA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Satellite thermal-anomaly detections (pipeline/satellite_hotspots.py,
# added 2026-07-31) — feeds Stage 4 raw heat-signature data (possible
# strikes, fires, gas flares — corroboration-required, see the prompt) via
# NASA FIRMS. Free, official, no credit card — register at
# https://firms.modaps.eosdis.nasa.gov/api/map_key/. If unset, the
# pipeline still runs normally; it just omits the hotspots section.
FIRMS_MAP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
